<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de backup e de transferência entre aparelhos (Android 12 ou superior).

  - Backup na nuvem do Android: nada é copiado. O backup do prontuário é feito apenas pelo
    Google Drive do próprio tutor, quando ele escolhe ativar.
  - Transferência direta entre aparelhos (cabo/Wi-Fi): banco, fotos e anexos acompanham o tutor, mas o
    estado da conexão com o Drive não, para que o novo aparelho peça um novo login.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="stella_drive_sync.xml" />
    </device-transfer>
</data-extraction-rules>
